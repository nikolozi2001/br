{
  "expo": {
    "name": "ბიზნეს რეგისტრი",
    "slug": "geostat-business-register",
    "scheme": "geostat-br",
    "version": "4.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ge.geostat.businessregister",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "ge.geostat.businessregister",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "ბიზნეს რეგისტრი ინახავს გრაფიკებს თქვენს ფოტოებში.",
          "photosPermission": "ბიზნეს რეგისტრი ინახავს გრაფიკებს თქვენს ფოტოებში.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c8cfed9d-082a-427d-81f3-46c50c185c46"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c8cfed9d-082a-427d-81f3-46c50c185c46"
    }
  }
}
